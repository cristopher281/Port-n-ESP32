{
    "version": 2,
    "builds": [
        { "src": "frontend/package.json", "use": "@vercel/static-build", "config": { "distDir": "frontend/dist" } }
    ],
    "routes": [
        { "src": "/api/(.*)", "dest": "/api/index.js" },
        { "src": "/(.*)", "dest": "/index.html" }
    ],
    "functions": {
        "api/index.js": {
            "includeFiles": "backend/**"
        }
    }
}